@cykv 1
@schema "cypher.theme" 2
// Bundled preset, ported from the TileEditor palette of the same name.
// Partial on purpose: it sets the base colours and names Charcoal as its
// base, so every derived shade follows these colours (CYTHEME.md 3).
{
    id = "midnight"
    name = "Midnight"
    author = "CypherEngine"
    description = "Deep navy interface with violet accents."
    appearance = "dark"
    base = "charcoal"
    colors = {
        // Interface: base colours.
        "ui.background" = "#171b25"
        "ui.panel" = "#10131c"
        "ui.text" = "#c4cedd"
        "ui.accent" = "#9f8fff"

        // Viewport: frame.
        "viewport.active_border" = "#7e96e6"

        // Viewport: backgrounds and grid.
        "viewport.background.2d" = "#101927"
        "viewport.background.3d" = "#0c1119"
        "viewport.grid.minor" = "#1c2c3b"
        "viewport.grid.major" = "#345169"
        "viewport.axis.x" = "#de524c"
        "viewport.axis.y" = "#52be69"
        "viewport.axis.z" = "#4b8be8"

        // Viewport: objects.
        "viewport.wire.world" = "#9baec8"
        "viewport.wire.entity" = "#5dabd9"
        "viewport.wire.patch" = "#72b5a0"
        "viewport.wire.terrain" = "#c8a366"
        "viewport.face.world" = "#6f8b99"
        "viewport.selection" = "#c5acff"
        "viewport.selection.fill" = "#c5acff40"
    }
}
