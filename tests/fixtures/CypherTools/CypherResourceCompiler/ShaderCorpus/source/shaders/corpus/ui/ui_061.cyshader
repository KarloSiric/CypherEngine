@cykv 1
@schema "cypher.shader" 1

// Integration corpus recipe 061: ui pipeline variant 01.
// This authored document intentionally shares GLSL stages while changing the
// define set, exercising deterministic preprocessing and cooked identities.
{
    /* NOTE: here we will be adding things that we wnat to add */
    /* FIXME: Adding this to showcase that the compilation does indeed work. */
    /*
        Something whatever the hel
        that is.
    */
    language = "glsl"       // this is to indicate the language and in this OpenGL language for shaders which is glsl
    vertex = "shaders/corpus/stages/ui.vert"
    fragment = "shaders/corpus/stages/ui.frag"

    defines = [
        "CY_CORPUS",
        "CY_UI_PASS",
        "CY_VARIANT_061",
        "CY_FAMILY_VARIANT_01",
        "CY_UI_MONOCHROME",
        "CY_UI_PREMULTIPLIED",
        "CY_UI_CLIP_ALPHA"
    ]
}
