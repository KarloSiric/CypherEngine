# //
# //  File: .gitignore
# //  Purpose: Defines ignored local, generated, and build artifacts.
# //  Details: This file keeps generated artifacts, build outputs, local logs, and
# //           editor noise out of version control. Do not use it to hide source files
# //           that should be reviewed.
# //
# //  History:
# //  - Created by Karlo Siric on 2026-04-18
# //
# //  This file is proprietary and confidential. See LICENSE for details.
# //
# //////////////////////////////////////////////////////////////////////////

# Build directories
/build/
/build-*/
/build-bench/
/build-clangd/
/bin/
/out/
/dist/
/cmake-build-*/
/CMakeFiles/
/CMakeCache.txt
/compile_commands.json
Testing/
/CTestTestfile.cmake
/cmake_install.cmake
/install_manifest.txt
/Makefile

# Ignoring unnecessary MD files
CLAUDE.md
CODEX.md
AGENTS.md

# Compiler and linker artifacts
*.o
*.obj
*.lo
*.la
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app
*.pdb
*.idb
*.ilk
*.dSYM/

# Logs and temporary files
*.log
*.tmp
*.temp
*.bak
*.swp
*.swo
*.orig
*.rej

# IDE and editor files
.idea/
.vscode/
.vs/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Python helpers and caches
__pycache__/
*.pyc

# Asset pipeline outputs
/data/**/*.rmdl
/data/**/*.rtex
/data/**/*.rpak
/data/**/*.bin
/data/**/*.bsp

# Tool caches
/.cache/
/tools/**/build/
/tools/**/out/

# Benchmark captures
/benchmarks/results/*
!/benchmarks/results/.gitkeep
