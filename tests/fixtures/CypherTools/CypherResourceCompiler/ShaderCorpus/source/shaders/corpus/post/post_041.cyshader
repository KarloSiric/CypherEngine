@cykv 1
@schema "cypher.shader" 1

// Integration corpus recipe 041: post pipeline variant 01.
// This authored document intentionally shares GLSL stages while changing the
// define set, exercising deterministic preprocessing and cooked identities.
{
    language = "glsl"
    vertex = "shaders/corpus/stages/post.vert"
    fragment = "shaders/corpus/stages/post.frag"

    defines = [
        "CY_CORPUS",
        "CY_POST_PASS",
        "CY_VARIANT_041",
        "CY_FAMILY_VARIANT_01",
        "CY_PIXELATE",
        "CY_SCANLINES",
        "CY_VIGNETTE"
    ]
}
