@cykv 1
@schema "cypher.theme" 2
// Bundled preset, ported from the TileEditor palette of the same name.
// Partial on purpose: it sets the base colours and names Charcoal as its
// base, so every derived shade follows these colours (CYTHEME.md 3).
{
    id = "high_contrast_dark"
    name = "High Contrast Dark"
    author = "CypherEngine"
    description = "Near-black surfaces, bright text, and saturated geometry for maximum legibility."
    appearance = "dark"
    base = "charcoal"
    colors = {
        // Interface: base colours.
        "ui.background" = "#171717"
        "ui.panel" = "#0d0d0d"
        "ui.text" = "#f3f3f3"
        "ui.accent" = "#ffb000"

        // Viewport: frame.
        "viewport.active_border" = "#ff4949"

        // Viewport: backgrounds and grid.
        "viewport.background.2d" = "#080f14"
        "viewport.background.3d" = "#050505"
        "viewport.grid.minor" = "#1d2b34"
        "viewport.grid.major" = "#637582"
        "viewport.axis.x" = "#ff5a5a"
        "viewport.axis.y" = "#62dc79"
        "viewport.axis.z" = "#61a8ff"

        // Viewport: objects.
        "viewport.wire.world" = "#f2f2f2"
        "viewport.wire.entity" = "#70d0ff"
        "viewport.wire.patch" = "#72e0a7"
        "viewport.wire.terrain" = "#ffd166"
        "viewport.face.world" = "#a7b8c1"
        "viewport.selection" = "#ffc247"
        "viewport.selection.fill" = "#ffc24740"
    }
}
