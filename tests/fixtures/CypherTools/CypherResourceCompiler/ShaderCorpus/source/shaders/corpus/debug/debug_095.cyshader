@cykv 1
@schema "cypher.shader" 1

// Integration corpus recipe 095: debug pipeline variant 15.
// This authored document intentionally shares GLSL stages while changing the
// define set, exercising deterministic preprocessing and cooked identities.
{
    language = "glsl"
    vertex = "shaders/corpus/stages/debug.vert"
    fragment = "shaders/corpus/stages/debug.frag"

    defines = [
        "CY_CORPUS",
        "CY_DEBUG_PASS",
        "CY_VARIANT_095",
        "CY_FAMILY_VARIANT_15",
        "CY_DEBUG_WIREFRAME",
        "CY_DEBUG_OVERDRAW"
    ]
}
