@cykv 1
@schema "cypher.shader" 1

// Integration corpus recipe 023: character pipeline variant 03.
// This authored document intentionally shares GLSL stages while changing the
// define set, exercising deterministic preprocessing and cooked identities.
{
    language = "glsl"
    vertex = "shaders/corpus/stages/character.vert"
    fragment = "shaders/corpus/stages/character.frag"

    defines = [
        "CY_CORPUS",
        "CY_CHARACTER_PASS",
        "CY_VARIANT_023",
        "CY_FAMILY_VARIANT_03",
        "CY_DAMAGE_FLASH",
        "CY_SHADOW_RECEIVER",
        "CY_MOTION_VECTORS",
        "CY_SKINNED",
        "CY_RIM_LIGHT"
    ]
}
