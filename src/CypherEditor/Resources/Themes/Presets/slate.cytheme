@cykv 1
@schema "cypher.theme" 2
// Bundled preset, ported from the TileEditor palette of the same name.
// Partial on purpose: it sets the base colours and names Charcoal as its
// base, so every derived shade follows these colours (CYTHEME.md 3).
{
    id = "slate"
    name = "Slate"
    author = "CypherEngine"
    description = "Cool slate-blue 2D views with a neutral grey interface."
    appearance = "dark"
    base = "charcoal"
    colors = {
        // Interface: base colours.
        "ui.background" = "#363636"
        "ui.panel" = "#303030"
        "ui.text" = "#dce0e5"
        "ui.accent" = "#e1a03e"

        // Viewport: frame.
        "viewport.active_border" = "#d93e36"

        // Viewport: backgrounds and grid.
        "viewport.background.2d" = "#334b60"
        "viewport.background.3d" = "#111315"
        "viewport.grid.minor" = "#3c566c"
        "viewport.grid.major" = "#567087"
        "viewport.axis.x" = "#de524c"
        "viewport.axis.y" = "#52be69"
        "viewport.axis.z" = "#4b8be8"

        // Viewport: objects.
        "viewport.wire.world" = "#cbd3db"
        "viewport.wire.entity" = "#8fbdd9"
        "viewport.wire.patch" = "#97d8b7"
        "viewport.wire.terrain" = "#ddad59"
        "viewport.face.world" = "#6f8b99"
        "viewport.selection" = "#e19a44"
        "viewport.selection.fill" = "#e19a4440"
    }
}
