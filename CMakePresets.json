{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "toolchainFile": "${sourceDir}/.deps/vcpkg/scripts/buildsystems/vcpkg.cmake",
      "environment": {
        "CPATH": "",
        "C_INCLUDE_PATH": "",
        "CPLUS_INCLUDE_PATH": "",
        "OBJC_INCLUDE_PATH": "",
        "LIBRARY_PATH": ""
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "displayName": "Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "base",
      "displayName": "RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "displayName": "Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests"
      }
    },
    {
      "name": "bench-release",
      "inherits": "base",
      "displayName": "Bench Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CYPHERENGINE_BUILD_BENCHMARKS": "ON",
        "VCPKG_MANIFEST_FEATURES": "benchmarks"
      }
    },
    {
      "name": "bench-relwithdebinfo",
      "inherits": "base",
      "displayName": "Bench RelWithDebInfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CYPHERENGINE_BUILD_BENCHMARKS": "ON",
        "VCPKG_MANIFEST_FEATURES": "benchmarks"
      }
    },
    {
      "name": "asan-ubsan",
      "inherits": "base",
      "displayName": "ASan UBSan Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "dependencies-all",
      "inherits": "base",
      "displayName": "Resolve All Approved Dependencies",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CYPHERENGINE_BUILD_BENCHMARKS": "ON",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "VCPKG_MANIFEST_FEATURES": "archive-tools;asset-import-fallback;audio;benchmarks;editor-support;image-import;math;mesh-pipeline;networking;profiling;scripting;security;shader-tools;tests;text;texture-pipeline"
      }
    },
    {
      "name": "shader-tools-debug",
      "inherits": "base",
      "displayName": "Shader Tools Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "CYPHERENGINE_BUILD_TOOLS": "ON",
        "VCPKG_MANIFEST_FEATURES": "image-import;shader-tools;tests"
      }
    },
    {
      "name": "shader-tools-release",
      "inherits": "base",
      "displayName": "Shader Tools Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "CYPHERENGINE_BUILD_TOOLS": "ON",
        "VCPKG_MANIFEST_FEATURES": "image-import;shader-tools;tests"
      }
    },
    {
      "name": "asset-tools-debug",
      "inherits": "base",
      "displayName": "Render Asset Tools Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "CYPHERENGINE_BUILD_TOOLS": "ON",
        "VCPKG_MANIFEST_FEATURES": "image-import;shader-tools;tests"
      }
    },
    {
      "name": "asset-tools-release",
      "inherits": "base",
      "displayName": "Render Asset Tools Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "CYPHERENGINE_BUILD_TOOLS": "ON",
        "VCPKG_MANIFEST_FEATURES": "image-import;shader-tools;tests"
      }
    },
    {
      "name": "picasso-debug",
      "inherits": "base",
      "displayName": "Picasso Qt6 Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CYPHERENGINE_BUILD_TESTS": "ON",
        "CYPHERENGINE_BUILD_TOOLS": "ON",
        "CYPHERENGINE_BUILD_PICASSO": "ON",
        "VCPKG_MANIFEST_FEATURES": "image-import;shader-tools;tests"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "bench-release",
      "configurePreset": "bench-release"
    },
    {
      "name": "bench-relwithdebinfo",
      "configurePreset": "bench-relwithdebinfo"
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan"
    },
    {
      "name": "dependencies-all",
      "configurePreset": "dependencies-all"
    },
    {
      "name": "shader-tools-debug",
      "configurePreset": "shader-tools-debug"
    },
    {
      "name": "shader-tools-release",
      "configurePreset": "shader-tools-release"
    },
    {
      "name": "asset-tools-debug",
      "configurePreset": "asset-tools-debug"
    },
    {
      "name": "asset-tools-release",
      "configurePreset": "asset-tools-release"
    },
    {
      "name": "picasso-debug",
      "configurePreset": "picasso-debug"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan-ubsan",
      "configurePreset": "asan-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "shader-tools-debug",
      "configurePreset": "shader-tools-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "shader-tools-release",
      "configurePreset": "shader-tools-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asset-tools-debug",
      "configurePreset": "asset-tools-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asset-tools-release",
      "configurePreset": "asset-tools-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "picasso-debug",
      "configurePreset": "picasso-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
