@cykv 1
@schema "cypher.shader" 1

// Integration corpus recipe 006: world pipeline variant 06.
// This authored document intentionally shares GLSL stages while changing the
// define set, exercising deterministic preprocessing and cooked identities.
{
    language = "glsl"
    vertex = "shaders/corpus/stages/world.vert"
    fragment = "shaders/corpus/stages/world.frag"

    defines = [
        "CY_CORPUS",
        "CY_WORLD_PASS",
        "CY_VARIANT_006",
        "CY_FAMILY_VARIANT_06",
        "CY_USE_VERTEX_COLOR",
        "CY_USE_FOG",
        "CY_ALPHA_TEST"
    ]
}
